{
  "name": "browser-operator",
  "version": "1.4.0",
  "description": "Connects your live Google Chrome browser directly to AI Agents and MCP clients without restarting Chrome, preserving all active logins and cookies.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "bridge": "node server/bridge.js",
    "token": "node -e \"console.log(require('./server/auth.js').getOrCreateToken())\"",
    "test-client": "node test/test-client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hashan-lakshitha/browser-operator.git"
  },
  "keywords": [
    "browser-operator",
    "mcp",
    "model-context-protocol",
    "chrome-extension",
    "ai-agent",
    "manus",
    "browser-automation",
    "cdp"
  ],
  "author": "Hashan Walauwatta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hashan-lakshitha/browser-operator/issues"
  },
  "homepage": "https://github.com/hashan-lakshitha/browser-operator#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "ws": "^8.18.0"
  }
}
